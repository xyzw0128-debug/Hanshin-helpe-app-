<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 모든 네트워크 통신에 HTTPS 강제 (평문 HTTP 전면 차단 / MITM 방어) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
